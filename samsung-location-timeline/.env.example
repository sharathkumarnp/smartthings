DATABASE_URL=postgresql://timeline:timeline@localhost:5432/timeline?schema=public
APP_URL=http://localhost:3000
TZ=Asia/Kolkata
AUTH_SECRET=replace-with-at-least-32-random-characters
ADMIN_EMAIL=owner@example.com
# Generate with: node -e "console.log(require('bcryptjs').hashSync(process.argv[1], 12))" 'your-password'
ADMIN_PASSWORD_HASH=
LOCATION_PROVIDER=mock
LOCATION_POLL_INTERVAL_MINUTES=15
COLLECTOR_INTERNAL_SECRET=replace-with-an-independent-random-secret
STALE_LOCATION_MINUTES=30
STOP_RADIUS_METERS=100
STOP_MIN_DURATION_MINUTES=30
TRIP_MIN_DISTANCE_METERS=150
PROVIDER_TIMEOUT_MS=15000
PROVIDER_MAX_RETRIES=3
GOOGLE_MAPS_API_KEY=
SAMSUNG_DEVICE_ID=
# Official SmartThings OAuth/PAT bearer token. Never expose client-side or commit it.
SMARTTHINGS_ACCESS_TOKEN=
# Internal Docker WebDriver endpoint for the interactive Samsung Find viewer.
SAMSUNG_FIND_WEBDRIVER_URL=http://samsung-browser:4444
LOG_LEVEL=info
